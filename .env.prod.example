# ============================================================
#  SmartCampaign — PRODUCTION Environment Variables
#  Usage: copy this to .env.prod then:
#         docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
#  ⚠️  NEVER commit .env.prod to git — it's in .gitignore
# ============================================================

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=replace-with-production-db-user
POSTGRES_PASSWORD=replace-with-a-unique-32-plus-character-password

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-unique-32-plus-character-password

# ─── JWT (64-byte random hex — DO NOT SHARE) ─────────────────
JWT_SECRET=replace-with-a-random-64-plus-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AES-256 Fernet Encryption Key ───────────────────────────
ENCRYPTION_KEY=replace-with-a-valid-fernet-key-generated-by-cryptography

# ─── Your Production Domain ──────────────────────────────────
# Change to your real domain after setting up SSL
TRACKING_BASE_URL=https://yourdomain.com

# ─── Environment flag (disables Swagger UI) ──────────────────
ENVIRONMENT=production

# ─── Admin Registration invite code ──────────────────────────
ADMIN_REGISTRATION_SECRET=replace-with-a-random-32-plus-character-secret
