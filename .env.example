# Copy to .env and replace every value before starting Docker Compose.
POSTGRES_USER=local_app_user
POSTGRES_PASSWORD=replace-with-a-local-password
REDIS_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://local_app_user:replace-with-a-local-password@db:5432/smartcampaign
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ADMIN_REGISTRATION_SECRET=replace-with-a-random-32-plus-character-secret
TRACKING_BASE_URL=http://localhost:8000
ENVIRONMENT=development
