# Database Configuration (Supabase or Local Docker PG)
# For local Docker: postgresql+asyncpg://postgres:password123@db:5432/smartcampaign
# For Supabase: postgresql+asyncpg://postgres:[your-password]@[your-supabase-host]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/smartcampaign

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security Setup
JWT_SECRET=supersecretjwtkeyfor_smartcampaign_sass_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 Key for Encrypting SMTP passwords stored in DB (Must be 32 bytes encoded in urlsafe base64)
# You can generate one using: cryptography.fernet.Fernet.generate_key()
ENCRYPTION_KEY=gK-xW32Lkd0w3UuWlkd_98D-Jskd0923Lkd_923Jka8=

# Email Tracking Base URL (Domain where API is served, e.g., https://beta.smartcampaign.today)
TRACKING_BASE_URL=http://localhost:8000
